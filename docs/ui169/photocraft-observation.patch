+#[test]
+fn an_uncommitted_native_crop_blocks_host_mutation_and_checkpoint_ack() {
+    let mut app = image();
+    let before = call(&mut app, "host.context", json!({}))["result"].clone();
+    app.ui.crop_rect = Some([2.0, 3.0, 20.0, 18.0]);
+    let pending = call(&mut app, "host.context", json!({}))["result"].clone();
+    assert_eq!(pending["pendingInteraction"], true, "an uncommitted crop must retain manual ownership");
+    assert_eq!(call(&mut app, "host.execute", json!({"base":before,"command":"layer.setProps","params":{"opacity":0.2}}))["ok"], false);
+    assert_eq!(call(&mut app, "host.snapshot", json!({"format":"pcraft"}))["ok"], false);
+    assert_eq!(call(&mut app, "host.saved", json!({"uid":before["uid"],"revision":before["revision"],"checkpoint":"a".repeat(64)}))["result"]["acknowledged"], false);
+    assert_eq!(app.session.active().unwrap().doc.layers[0].opacity, 1.0);
+    app.ui.crop_rect = None;
+    assert_eq!(call(&mut app, "host.context", json!({}))["result"]["pendingInteraction"], false);
+    app.ui.crop_rect = Some([0.0, 0.0, 32.0, 24.0]);
+    app.crop.default_frame = true;
+    assert_eq!(call(&mut app, "host.context", json!({}))["result"]["pendingInteraction"], false, "an untouched default frame is not a pending edit");
+    app.ui.crop_rect = None;
+    app.crop.default_frame = false;
+    app.ui.perspective_crop = Some([[0.0, 0.0], [16.0, 0.0], [16.0, 16.0], [0.0, 16.0]]);
+    assert_eq!(call(&mut app, "host.context", json!({}))["result"]["pendingInteraction"], true);
+    app.ui.perspective_crop = None;
+    app.run("edit.fill", json!({"color":"#336699"})).unwrap();
+    crate::transform_tool::begin(&mut app, &egui::Context::default()).unwrap();
+    assert!(app.ui.transform.is_some());
