+async fn read_picked(file: &rfd::FileHandle, hosted: bool) -> Result<Vec<u8>, String> {
+    if !hosted {
+        return Ok(file.read().await);
+    }
+    // These handles come only from pick_file(s), which rfd constructs as Readable.
+    // Save handles are handled in a separate match arm and never enter this function.
+    let source = file.inner();
+    let size = source.size();
+    if !size.is_finite() || size <= 0.0 || size > 256.0 * 1024.0 * 1024.0 {
+        return Err("The selected file is empty or exceeds 256 MiB".into());
+    }
+    let buffer = wasm_bindgen_futures::JsFuture::from(source.array_buffer()).await.map_err(|error| format!("Could not read the selected file: {error:?}"))?;
+    let bytes = js_sys::Uint8Array::new(&buffer);
+    if f64::from(bytes.length()) != size {
+        return Err("The selected file changed while being read".into());
+    }
+    Ok(bytes.to_vec())
+}
 
