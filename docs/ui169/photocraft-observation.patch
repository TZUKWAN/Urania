+//! A read can bypass the frame queue only after all observed activity reached the UI.
+#[derive(Clone, Copy, Default)]
+pub(crate) struct Observation {
+    epoch: Option<u64>,
+    committed: Option<u64>,
+}
+
+impl Observation {
+    pub(crate) const fn new() -> Self {
+        Self { epoch: Some(0), committed: None }
+    }
+    pub(crate) fn activity(&mut self) {
+        self.epoch = self.epoch.and_then(|value| value.checked_add(1));
+    }
+    pub(crate) fn epoch(self) -> Option<u64> {
+        self.epoch
+    }
+    pub(crate) fn commit(&mut self, frame_start: Option<u64>) {
+        self.committed = frame_start;
+    }
+    pub(crate) fn ready(self) -> bool {
+        self.epoch.is_some() && self.epoch == self.committed
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Observation;
+    #[test]
+    fn input_or_request_during_frame_needs_a_later_ui_commit() {
+        let mut gate = Observation::new();
+        assert!(!gate.ready());
+        gate.commit(gate.epoch());
+        assert!(gate.ready());
+        gate.activity();
+        let frame_start = gate.epoch();
+        gate.activity();
+        gate.commit(frame_start);
+        assert!(!gate.ready());
+        gate.commit(gate.epoch());
+        assert!(gate.ready());
+    }
+    #[test]
+    fn overflow_permanently_falls_back_to_the_original_frame_queue() {
+        let mut gate = Observation { epoch: Some(u64::MAX), committed: Some(u64::MAX) };
+        gate.activity();
+        gate.commit(gate.epoch());
+        assert!(!gate.ready());
+        gate.activity();
+        assert!(!gate.ready());
+    }
+}
