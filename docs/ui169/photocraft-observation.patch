+#[test]
+fn hosted_theme_and_language_leave_saved_preferences_and_standalone_palette_intact() {
+    let mut app = image();
+    let prefs = serde_json::to_value(app.session.prefs()).unwrap();
+    let original_language = app.effective_ui_language().to_string();
+    let original_theme = app.ui.theme;
+    let ctx = egui::Context::default();
+    let request = |embedded| ControlRequest::new("host.configure", json!({"embedded":embedded,"brightness":"light"})).0;
+    assert!(matches!(crate::control::handle(&mut app, &ctx, &request(true)), Outcome::Done(_)));
+    assert_eq!(app.effective_ui_language(), "zh-hans");
+    assert_eq!(crate::theme::Tokens::get(&ctx).accent, egui::Color32::from_rgb(0x28, 0x7D, 0x6C));
+    assert_eq!(serde_json::to_value(app.session.prefs()).unwrap(), prefs);
+    assert!(matches!(crate::control::handle(&mut app, &ctx, &request(false)), Outcome::Done(_)));
+    assert_eq!(app.effective_ui_language(), original_language);
+    assert_eq!(crate::theme::Tokens::get(&ctx).accent, crate::theme::Tokens::for_kind(original_theme).accent);
+    assert_eq!(serde_json::to_value(app.session.prefs()).unwrap(), prefs);
+}
