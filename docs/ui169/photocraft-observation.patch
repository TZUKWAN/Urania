+use super::*;
+use photocraft_engine::Session;
+use serde_json::{Value, json};
+
+fn call(app: &mut PhotocraftApp, method: &str, params: Value) -> Value {
+    let (request, _) = ControlRequest::new(method, params);
+    match crate::control::handle(app, &egui::Context::default(), &request) {
+        Outcome::Done(value) => value,
+        _ => panic!("expected immediate native host response"),
+    }
+}
+fn image() -> PhotocraftApp {
+    let mut app = PhotocraftApp::new(Session::new(), crate::Services::default());
+    app.background_jobs = false;
+    let result = call(&mut app, "host.create", json!({"width":32,"height":24,"name":"Actual image","depth":16,"background":"transparent"}));
+    assert_eq!(result["ok"], true, "{result}");
+    app
+}
