+/// Common file actions are provided by the source-owning workspace. Special
+/// file tools and native shortcuts remain available in the embedded editor.
+fn hosted_file_items(items: Vec<&MenuItem>) -> Vec<&MenuItem> {
+    let mut out = Vec::new();
+    for item in items {
+        if matches!(item.id.as_str(), "file.open" | "file.openAs" | "file.save" | "file.saveAs" | "file.saveACopy" | "file.close" | "file.closeAll" | "file.closeOthers") { continue; }
+        if item.id == "---" && (out.is_empty() || out.last().is_some_and(|last: &&MenuItem| last.id == "---")) { continue; }
+        out.push(item);
+    }
+    if out.last().is_some_and(|last| last.id == "---") { out.pop(); }
+    out
+}
