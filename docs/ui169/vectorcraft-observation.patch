+/// Route text-tool input and command chords while preserving IME composition ownership.
+/// Ordinary typing before Escape belongs to the edit being finished. Drain that
+/// prefix in order, including Select All/newlines, rather than ending the tool
+/// first and silently dropping its text. Guarded IME, pointer and other command
+/// batches keep their existing ownership/reset path.
+fn type_before_escape(app: &mut VectorcraftApp, ctx: &egui::Context) {
+    if !app.session.tool_wants_text() || app.session.tool_composing() || crate::ime::blocked(app, ctx) {
+        return;
+    }
+    let split = ctx.input(|input| {
+        if input.events.iter().any(|event| matches!(event, egui::Event::Ime(_) | egui::Event::ImeResetCompleted { .. })) {
+            return None;
+        }
+        let split = input.events.iter().position(
+            |event| matches!(event, egui::Event::Key { key: Key::Escape, pressed: true, modifiers, .. } if *modifiers == Modifiers::NONE),
+        )?;
+        if runs_a_command(input, Key::Escape, true) || !input.events.iter().take(split).any(|event| matches!(event, egui::Event::Text(_))) {
+            return None;
+        }
+        let shortcuts = all_shortcuts();
+        let safe = input.events.iter().take(split).all(|event| match event {
+            egui::Event::Text(_) | egui::Event::ModifiersChanged(_) => true,
+            egui::Event::Key { key, pressed, modifiers, .. } => {
+                !pressed
+                    || is_modifier(*key)
+                    || !(modifiers.ctrl || modifiers.command || modifiers.alt)
+                    || (*key == Key::A
+                        && shortcuts.iter().any(|(shortcut, command, _)| {
+                            *command == "select.all" && shortcut.logical_key == Key::A && modifiers.matches_logically(shortcut.modifiers)
+                        }))
+            }
+            _ => false,
+        });
+        safe.then_some(split)
+    });
+    let Some(split) = split else { return };
+    let mut prefix = ctx.input_mut(|input| std::mem::take(&mut input.events));
+    // The index came from this exact input vector; still bound it explicitly so
+    // untrusted input cannot turn a stale position into a slicing panic.
+    let suffix = prefix.split_off(split.min(prefix.len()));
+    for event in prefix {
+        if let egui::Event::Key { key: Key::Enter, pressed: true, modifiers, .. } = event {
+            let view = app.view_info();
+            let result = app.session.tool_key(ToolKey::Enter, crate::canvas::mods(modifiers, false), view);
+            crate::canvas::apply_requests(app, result);
+        } else {
+            ctx.input_mut(|input| input.events = vec![event]);
+            type_tool_input(app, ctx, false);
+        }
+    }
+    // Prefix key presses belonged to the text editor. Do not replay them as
+    // selection-tool shortcuts after Escape has finished that edit.
+    ctx.input_mut(|input| input.events = suffix);
 }
 
