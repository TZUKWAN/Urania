+    app.run("file.new", json!({"width": 64, "height": 48})).unwrap();
+    let base = input_request(&mut app, "host.context", json!({}))["result"].clone();
+    app.run("shape.rectangle", json!({"x": 10, "y": 12, "width": 20, "height": 16})).unwrap();
+    let source = app.run("document.serialize", json!({"format": "vectorcraft"})).unwrap();
+    for params in [json!({"base": base, "format": "svg"}), json!({"format": "svg"}), json!({"base": base, "format": "pdf"})] {
+        assert_eq!(input_request(&mut app, "host.bundle", params)["ok"], false);
+    }
+    assert_eq!(app.run("document.serialize", json!({"format": "vectorcraft"})).unwrap(), source);
+}
+
+#[test]
+fn hosted_snapshot_carries_native_bytes_with_the_same_document_revision() {
+    let mut app = VectorcraftApp::new(Session::new(), Services::default());
+    app.run("file.new", json!({"width": 640, "height": 480})).unwrap();
+    let snapshot = input_request(&mut app, "host.snapshot", json!({"format": "vectorcraft"}));
+    assert_eq!(snapshot["ok"], true, "{snapshot}");
+    assert!(snapshot["result"]["encoded"]["dataBase64"].as_str().is_some_and(|data| !data.is_empty()));
+    assert_eq!(snapshot["result"]["document"], app.run("document.inspect", json!({})).unwrap());
+}
+
+#[test]
+fn hosted_saved_acknowledgement_never_clears_a_newer_manual_revision() {
+    let mut app = VectorcraftApp::new(Session::new(), Services::default());
+    app.run("file.new", json!({"width": 640, "height": 480})).unwrap();
+    app.run("shape.rectangle", json!({"x": 0, "y": 0, "width": 20, "height": 20})).unwrap();
+    let old = app.run("document.inspect", json!({})).unwrap();
+    app.run("shape.rectangle", json!({"x": 40, "y": 0, "width": 20, "height": 20})).unwrap();
+    let current = app.run("document.inspect", json!({})).unwrap();
+    let checkpoint = "a".repeat(64);
+    let stale = input_request(&mut app, "host.saved", json!({"uid": old["uid"], "revision": old["revision"], "checkpoint": checkpoint}));
+    assert_eq!(stale["result"]["acknowledged"], false);
+    assert_eq!(app.run("document.inspect", json!({})).unwrap()["dirty"], true);
+    let accepted = input_request(&mut app, "host.saved", json!({"uid": current["uid"], "revision": current["revision"], "checkpoint": checkpoint}));
+    assert_eq!(accepted["result"]["acknowledged"], true);
+    assert_eq!(app.run("document.inspect", json!({})).unwrap()["dirty"], false);
 }
 
