+/// A single control-drain snapshot of native content, selection and page/tool
+/// context. No synthetic common-object projection owns the native selection.
+fn context_document(app: &mut VectorcraftApp, params: &Value) -> Result<Value, String> {
+    let mut document = app.run("document.inspect", params.clone()).map_err(|error| error.to_string())?;
+    let state = app.session.active().ok_or("no document open")?;
+    let mut selection = serde_json::to_value(&state.selection).map_err(|error| error.to_string())?;
+    let mut new_art: Vec<u64> = state.selection.new_art.iter().map(|id| id.0).collect();
+    new_art.sort_unstable();
+    if let Some(fields) = selection.as_object_mut() {
+        fields.insert("new_art".into(), json!(new_art));
+    }
+    let page_index = app.view().map(|view| view.artboard);
+    let page = page_index
+        .and_then(|index| {
+            document
+                .get("artboards")
+                .and_then(Value::as_array)
+                .and_then(|boards| boards.get(index))
+                .map(|artboard| json!({"kind": "artboard", "index": index, "artboard": artboard}))
+        })
+        .unwrap_or(Value::Null);
+    let tool = json!({"tool": app.session.tool_id(), "options": app.session.tool_options()});
+    // Objects are already fenced by base.selection. Keep the exact additional
+    // selection state as a canonical string, without a lossy JS numeric pass.
+    let mut detail = selection.clone();
+    if let Some(fields) = detail.as_object_mut() {
+        fields.remove("objects");
+    }
+    let stamp = serde_json::to_string(&json!({"selection": detail, "page": page_index, "tool": tool})).map_err(|error| error.to_string())?;
+    let fields = document.as_object_mut().ok_or("native inspect did not return an object")?;
+    let sequence = NEXT_CONTEXT_SEQUENCE
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| value.checked_add(1))
+        .map_err(|_| "native context sequence exhausted")?;
+    fields.insert("engine".into(), json!("vectorcraft"));
+    fields.insert("contextProtocol".into(), json!(2));
+    fields.insert("contextSequence".into(), json!(sequence));
+    fields.insert("nativeSelection".into(), json!({"kind": "vectorcraft", "data": selection}));
+    fields.insert("selectionStamp".into(), json!(stamp));
+    fields.insert("toolContext".into(), tool);
+    fields.insert("page".into(), page);
+    fields.insert("coordinateSpace".into(), json!("document"));
+    Ok(document)
+}
