+#![allow(clippy::unwrap_used, clippy::panic, clippy::expect_used)]
+// Real source/edited source were exported by an owned Vector app after a
+// physical path move. These are native commands, not mocked renderer results.
+use serde_json::{Value, json};
+use vectorcraft_color::BlendMode;
+use vectorcraft_doc::{NodeId, NodeKind};
+use vectorcraft_engine::Session;
+use vectorcraft_geom::Affine;
+const ORIGINAL: &[u8] = include_bytes!("fixtures/dsh-svg-source/source.vectorcraft");
+const EDITED: &[u8] = include_bytes!("fixtures/dsh-svg-source/edited-source.vectorcraft");
+fn material(id: &str) -> Value {
+    json!({"schema":1,"projectId":"project-fixture","assetId":id})
+}
+fn params(bytes: &[u8], asset: &str) -> Value {
+    json!({"sourceBase64":vectorcraft_format::base64_encode(bytes),"hostMaterial":material(asset)})
+}
+fn session() -> Session {
+    let mut s = Session::new();
+    s.execute("file.new", &json!({"width":640,"height":480})).unwrap();
+    s
+}
+fn place(s: &mut Session, x: f64) -> NodeId {
+    let mut p = params(ORIGINAL, "asset-original");
+    p["rect"] = json!([x, 60, 240, 180]);
+    NodeId(s.execute("svg.placeSource", &p).unwrap()["ids"][0].as_u64().unwrap())
+}
+fn origin(s: &Session, id: NodeId) -> Value {
+    let n = s.doc().unwrap().doc.node(id).unwrap();
+    serde_json::from_str(&n.extras().attrs.as_ref().unwrap().data.iter().find(|(k, _)| k == "dsh-material-v1").unwrap().1).unwrap()
+}
+fn source<'a>(doc: &'a vectorcraft_doc::Document, id: NodeId) -> &'a [u8] {
+    let NodeKind::PlacedDocument(p) = &doc.node(id).unwrap().kind else { panic!("expected embedded vector") };
+    assert!(p.is_embedded());
+    doc.images[&p.key].bytes.as_slice()
+}
