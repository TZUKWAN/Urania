+    let layers = std::mem::take(&mut doc.layers);
+    let nodes = super::on_artboard(&doc.symbol_boxes(), &layers, board);
+    Ok(DocumentArt { doc, nodes, clip: Some(board), frame: board, warnings: vec![] })
