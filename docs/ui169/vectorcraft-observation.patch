+/// Load an embedded native source without resolving or following any file path.
+pub(super) fn embedded_art(bytes: &[u8], cmd: &str) -> Result<DocumentArt> {
+    if bytes.is_empty() || bytes.len() > 4 * 1024 * 1024 || bytes.starts_with(&[0x1f, 0x8b]) || !vectorcraft_format::sniff(bytes) {
+        return Err(bad(cmd, "embedded Vector source must be an uncompressed native file within 4 MiB"));
+    }
+    let loaded = fileio::load("", bytes)?;
+    if !loaded.warnings.is_empty() { return Err(bad(cmd, "embedded Vector source has unresolved import warnings")); }
+    let mut doc = loaded.doc;
+    let mut external = false;
+    doc.visit_images(|_, image| {
+        external |= image.link.is_some() || doc.image_blob(image).is_none_or(|blob| blob.is_proxy());
+    });
+    doc.visit_placed(|_, _| external = true);
+    if external { return Err(bad(cmd, "embedded Vector source contains linked, missing or nested placed content")); }
