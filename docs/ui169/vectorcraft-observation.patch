+/// The surrounding workspace owns these common file operations in embedded
+/// mode. Leave specialised file tools and all non-hosted menus available.
+fn remove_host_file_duplicates(items: &mut Vec<Item>) {
+    items.retain(|item| !matches!(item, Item::Cmd(_, id, _) if matches!(*id,
+        "file.open" | "file.save" | "file.saveAs" | "file.saveCopy" | "file.close" | "file.closeAll")));
+    let mut separator = true;
+    items.retain(|item| {
+        if matches!(item, Item::Sep) {
+            if separator { false } else { separator = true; true }
+        } else { separator = false; true }
+    });
+    if matches!(items.last(), Some(Item::Sep)) { items.pop(); }
+}
+
+#[cfg(test)]
+#[test]
+fn hosted_file_menu_keeps_specialized_tools_and_removes_only_shared_actions() {
+    let tree = menu_tree_named(true);
+    let (_, original) = tree.into_iter().find(|(name, _)| *name == "File").unwrap();
+    let contains = |items: &[Item], wanted: &str| items.iter().any(|item| matches!(item, Item::Cmd(_, id, _) if *id == wanted));
+    assert!(contains(&original, "file.open") && contains(&original, "file.saveAs"));
+    let mut hosted = original.clone();
+    remove_host_file_duplicates(&mut hosted);
+    for id in ["file.open", "file.save", "file.saveAs", "file.saveCopy", "file.close", "file.closeAll"] { assert!(!contains(&hosted, id), "{id}"); }
+    for id in ["file.newDialog", "file.place", "file.documentSetup", "file.info"] { assert!(contains(&hosted, id), "{id}"); }
+    assert!(contains(&original, "file.open"), "standalone menu remains unchanged");
+}
 
