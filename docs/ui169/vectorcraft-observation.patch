+    pub id: &'static str,
+    pub label: &'static str,
+    pub menu: Vec<&'static str>,
+    pub shortcut: Option<&'static str>,
+    pub params: &'static str,
+    pub enabled: bool,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub disabled_reason: Option<String>,
+}
