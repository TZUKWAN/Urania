+#[test]
+fn linked_nested_and_compressed_sources_are_refused_without_mutation() {
+    use std::io::Write;
+    use vectorcraft_doc::{ImageBlob, ImageObject, LinkInfo, Node};
+    let mut source = vectorcraft_format::load(ORIGINAL).unwrap();
+    let layer = source.layers[0].id;
+    let key = "external-fixture".to_string();
+    let mut png = Vec::new();
+    image::RgbaImage::from_pixel(1, 1, image::Rgba([8, 30, 50, 255])).write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png).unwrap();
+    source.images.insert(key.clone(), ImageBlob::new("image/png", png));
+    let image = ImageObject {
+        key,
+        width: 1,
+        height: 1,
+        xf: Affine::IDENTITY,
+        link: Some(LinkInfo::new("C:/no-such-file.png")),
+        placement: Default::default(),
+        pixels: None,
+    };
+    let id = source.alloc_id();
+    source.insert(Some(layer), usize::MAX, Node::new(id, NodeKind::Image(Box::new(image)))).unwrap();
+    let external = vectorcraft_format::save(&source, false);
+    let mut nested = session();
+    place(&mut nested, 20.0);
+    let nested = vectorcraft_format::save(&nested.doc().unwrap().doc, false);
+    let mut gzip = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+    gzip.write_all(ORIGINAL).unwrap();
+    let compressed = gzip.finish().unwrap();
+    let mut target = session();
+    let before = target.doc().unwrap().doc.clone();
+    let undo = target.doc().unwrap().history.undo.len();
+    for bytes in [&external, &nested, &compressed] {
+        assert!(target.execute("svg.placeSource", &params(bytes, "asset-original")).is_err());
+        assert_eq!(*target.doc().unwrap().doc, *before);
+        assert_eq!(target.doc().unwrap().history.undo.len(), undo);
+    }
+}
