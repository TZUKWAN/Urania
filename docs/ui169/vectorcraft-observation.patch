+#[test]
+fn legacy_empty_absolute_link_is_not_reclassified_as_embedded() {
+    let mut s = session();
+    let id = place(&mut s, 20.0);
+    let NodeKind::PlacedDocument(p) = &s.doc().unwrap().doc.node(id).unwrap().kind else { panic!("vector") };
+    let mut legacy = (**p).clone();
+    legacy.embedded = false;
+    legacy.link.relative = Some("art/source.vectorcraft".into());
+    let value = serde_json::to_value(&legacy).unwrap();
+    assert!(value.get("embedded").is_none());
+    let reopened: vectorcraft_doc::PlacedDocument = serde_json::from_value(value).unwrap();
+    assert!(!reopened.is_embedded());
+    assert_eq!(reopened.link.relative.as_deref(), Some("art/source.vectorcraft"));
+}
