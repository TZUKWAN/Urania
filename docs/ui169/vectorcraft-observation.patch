-/// `result` with the PNG as `pngBase64` when there is one.
-fn with_data(mut result: Value, png: Option<&[u8]>) -> Value {
-    if let Some(png) = png {
-        result["pngBase64"] = json!(vectorcraft_format::base64_encode(png));
