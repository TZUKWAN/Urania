+pub(super) fn inspect(s: &mut Session, p: &Value) -> Result<Value> {
+    let ids = targets(s, p)?;
+    let [id] = ids.as_slice() else {
+        return Err(bad(CMD, "select exactly one SVG picture"));
+    };
+    let state = s.doc()?;
+    let shape = state.shape(*id).ok_or_else(|| bad(CMD, "SVG picture no longer exists"))?;
+    let ShapeKind::Picture { fill } = &shape.kind else {
+        return Err(bad(CMD, "selected object is not a picture"));
+    };
+    let source = fill.svg_source.and_then(|id| state.doc.media(id)).ok_or_else(|| bad(CMD, "picture has no preserved original SVG"))?;
+    if source.content_type != "image/svg+xml" || source.link.is_some() {
+        return Err(bad(CMD, "original SVG is unavailable or external"));
+    }
+    match parse(source.data.as_slice()) {
+        Ok(plan) => {
+            let paths = plan.items.iter().filter(|i| matches!(i.geometry, Geometry::Path(_))).count();
+            let texts = plan.items.len() - paths;
+            let eligibility = prepare(s, p).and_then(|(_, frame, plan)| converted_shapes(&plan, frame).map(|_| ()).map_err(|e| bad(CMD, e)));
+            let available = eligibility.is_ok();
+            let reason = eligibility.err().map(|error| error.to_string());
+            let items=plan.items.iter().map(|item|match &item.geometry {
+                Geometry::Path(d)=>json!({"name":item.name,"kind":"path","pathBytes":d.len(),"fill":item.style.fill,"stroke":item.style.stroke,"strokeWidth":item.style.stroke_width}),
+                Geometry::Text{x,y,value}=>json!({"name":item.name,"kind":"text","x":x,"y":y,"characters":value.chars().count(),"font":item.style.font,"fontSize":item.style.font_size,"fill":item.style.fill}),
+            }).collect::<Vec<_>>();
+            Ok(
+                json!({"analysisOnly":true,"conversionAvailable":available,"basicGeometryRecognized":true,"reason":reason,"objects":plan.items.len(),"paths":paths,"texts":texts,"viewBox":plan.view,"items":items,"warnings":if texts>0{vec!["Editable text can use different font metrics or baselines; the original SVG must be retained"]}else{vec![]}}),
+            )
+        }
+        Err(reason) => {
+            Ok(json!({"analysisOnly":true,"conversionAvailable":false,"basicGeometryRecognized":false,"reason":reason,"originalRetained":true}))
+        }
+    }
+}
