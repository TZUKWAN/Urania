+const TABS: [&str; 10] = ["Home", "Insert", "Draw", "Design", "Transitions", "Animations", "Slide Show", "Record", "Review", "View"];
+
+fn hosted_tab_label(name: &str) -> &str {
+    match name {
+        "Home" => "开始", "Insert" => "插入", "Draw" => "绘图", "Design" => "设计", "Transitions" => "切换",
+        "Animations" => "动画", "Slide Show" => "放映", "Record" => "录制", "Review" => "审阅", "View" => "视图",
+        "Slide Master" => "幻灯片母版", "Notes Master" => "备注母版", "Handout Master" => "讲义母版",
+        "Shape Format" => "形状格式", "Picture Format" => "图片格式", "Table Design" => "表格设计", "Layout" => "布局",
+        "SmartArt Design" => "图示设计", "Chart Design" => "图表设计", "Playback" => "播放", _ => name,
+    }
+}
