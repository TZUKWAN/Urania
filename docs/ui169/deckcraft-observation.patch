-    let ids: Vec<ShapeId> = s.doc()?.shapes().iter().filter(|x| !x.hidden && !x.locked).map(|x| x.id).collect();
-    s.select(|_, sel| sel.shapes = ids.clone())?;
-    Ok(json!({"ids": ids}))
