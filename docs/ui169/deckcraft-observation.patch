+/// Register a separately served, pinned runtime face without changing the wasm embed allowlist.
+pub fn install_runtime_face(bytes: Vec<u8>, family: &str) -> Result<(), String> {
+    if bytes.is_empty() || bytes.len() > 32 * 1024 * 1024 || family.is_empty() || family.len() > 200 {
+        return Err("runtime font exceeds its face/name budget".into());
+    }
+    let db = FontDb::global();
+    if db.add_font(bytes) == 0 {
+        return Err("runtime font bytes did not register a genuine face".into());
+    }
+    if !db.has_family(family) {
+        return Err("the runtime font did not provide its declared native family".into());
+    }
+    for c in "连续编辑演示图层".chars() {
+        if db.fallback_for(c, u32::MAX).is_none() {
+            return Err("runtime Chinese glyph coverage is incomplete".into());
+        }
+    }
+    Ok(())
+}
 
