+/// A number field running `shape.effects` with `{threeD: {key: value}}` when it changes.
+fn three_d_drag(app: &mut SlideApp, ui: &mut Ui, label: &str, value: f64, suffix: &str, key: &str) {
+    ui.horizontal(|ui| {
