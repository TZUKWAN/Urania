+    for entry in [Nav::Page(Page::Home), Nav::Page(Page::Open), Nav::Save, Nav::Page(Page::SaveAs), Nav::Close] { assert!(!top.contains(&entry)); }
+    assert!(entries_for(true, false).0.contains(&Nav::Page(Page::SaveAs)));
