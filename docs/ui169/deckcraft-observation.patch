+fn shape(session: &Session, id: ShapeId) -> &Shape {
+    session.doc().unwrap().doc.slides.iter().find_map(|slide| deckcraft_model::find_shape(&slide.shapes, id)).unwrap()
+}
+fn fill(shape: &Shape) -> &PictureFill {
+    let ShapeKind::Picture { fill } = &shape.kind else { panic!("expected actual picture") };
+    fill
+}
+fn assert_pair(p: &Presentation, shape: &Shape) {
+    let fill = fill(shape);
+    let source = p.media(fill.svg_source.unwrap()).unwrap();
+    let preview = p.media(fill.media).unwrap();
+    assert_eq!(source.content_type, "image/svg+xml");
+    assert_eq!(source.data.as_slice(), SVG);
+    assert_eq!(preview.content_type, "image/png");
+    assert_eq!(preview.data.as_slice(), PNG);
+    assert_ne!(source.id, preview.id);
+}
+fn paired() -> (Session, ShapeId) {
+    let mut s = Session::new();
