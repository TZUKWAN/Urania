+fn call(app: &mut SlideApp, method: &str, params: Value) -> Value {
+    let (request, _) = ControlRequest::new(method, params);
+    match crate::control::handle(app, &egui::Context::default(), &request) {
+        Outcome::Done(value) => value,
+        _ => panic!("expected immediate host response"),
+    }
+}
+fn app() -> SlideApp {
+    let mut app = SlideApp::new(Session::new(), crate::Services::default());
+    assert_eq!(call(&mut app, "host.configure", json!({"embedded":true,"fileRouting":true,"brightness":"light"}))["ok"], true);
