+                    let revision = self.session.active().map(|d| d.revision);
+                    match self.session.key(name, mods) {
+                        Ok(_) => {}
+                        Err(e) => self.set_status(e.to_string()),
+                    }
+                    if self.session.active().map(|d| d.revision) != revision {
+                        self.note_application_edit(ctx);
+                    }
+                }
+                _ => {}
+            }
+        }
