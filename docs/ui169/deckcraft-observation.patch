+        picture.xfrm.as_mut().unwrap().rot = 31.0;
+        picture.xfrm.as_mut().unwrap().flip_h = true;
+        let ShapeKind::Picture { fill } = &mut picture.kind else { panic!("picture") };
+        fill.upright = true;
