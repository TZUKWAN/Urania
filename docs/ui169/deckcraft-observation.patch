+                        return Err("SVG object count exceeds budget".into());
+                    }
+                }
+            }
+            Event::Text(t) => {
+                let text = t.decode().map_err(|e| e.to_string())?;
+                if stack.last().is_some_and(|f| f.tag == "tspan") {
+                    let parent = stack
+                        .len()
+                        .checked_sub(2)
+                        .and_then(|i| stack.get_mut(i))
+                        .and_then(|f| f.text.as_mut())
+                        .ok_or("SVG text span has no parent text")?;
+                    parent.value.push_str(&text);
+                    if parent.value.len() > 100_000 {
+                        return Err("SVG text exceeds budget".into());
+                    }
+                } else if let Some(frame) = stack.last_mut() {
+                    if let Some(builder) = &mut frame.text {
+                        if builder.span && !text.is_empty() {
+                            return Err("mixed SVG text spans are unsupported".into());
+                        }
+                        builder.value.push_str(&text);
+                        if builder.value.len() > 100_000 {
+                            return Err("SVG text exceeds budget".into());
+                        }
+                    } else if !matches!(frame.tag.as_str(), "title" | "desc") && !text.trim().is_empty() {
+                        return Err("unexpected SVG text".into());
+                    }
+                } else if !text.trim().is_empty() {
+                    return Err("text outside SVG".into());
+                }
+            }
+            Event::GeneralRef(_) | Event::CData(_) | Event::DocType(_) => return Err("SVG entities or CDATA are unsupported for conversion".into()),
+            Event::Eof => break,
+            _ => {}
+        }
+    }
+    if !stack.is_empty() || items.is_empty() {
+        return Err("SVG has no supported visible objects".into());
+    }
+    Ok(Plan { view: view.ok_or("missing SVG viewBox")?, items })
+}
