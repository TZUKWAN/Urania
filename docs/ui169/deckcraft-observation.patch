+fn current_theme(app: &SlideApp) -> String {
+    app.session
+        .active()
+        .and_then(|d| d.doc.masters.first())
+        .map(|m| m.theme.name.clone())
+        .filter(|n| !n.is_empty())
+        .unwrap_or_else(|| "DeckCraft".into())
+}
