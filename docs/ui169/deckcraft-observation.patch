-    let rh = 40.0;
-    let rect = rect_param(p, "rect").unwrap_or(Xfrm::new(size.width * 0.1, (size.height - rh * rows as f64).max(0.0) / 2.0, w, rh * rows as f64));
-    let mut t = Table::new(rows, cols, rect.w, rect.h / rows as f64);
