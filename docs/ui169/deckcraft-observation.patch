+/// Keep presentation-specific tools in the native panel while the source-owning
+/// host provides the common open/save/export/close workflow.
+fn entries_for(has_doc: bool, host_file_routing: bool) -> (Vec<Nav>, Vec<Nav>) {
+    if !host_file_routing { return entries(has_doc); }
+    let mut top = vec![Nav::Page(Page::New)]; // Native starter templates remain available.
+    if has_doc { top.extend([Nav::Page(Page::Info), Nav::Page(Page::Print), Nav::Page(Page::Export)]); }
+    (top, vec![Nav::Page(Page::Account), Nav::Options])
+}
+
+fn hosted_nav_label(nav: Nav) -> &'static str {
+    match nav {
+        Nav::Page(Page::New) => "模板", Nav::Page(Page::Info) => "信息", Nav::Page(Page::Print) => "打印",
+        Nav::Page(Page::Export) => "高级导出", Nav::Page(Page::Account) => "账户", Nav::Options => "设置", _ => nav.label(),
+    }
+}
