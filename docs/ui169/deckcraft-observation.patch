+fn png(color: [u8; 4], w: u32, h: u32) -> Vec<u8> {
+    let image = image::RgbaImage::from_fn(w, h, |x, y| {
+        image::Rgba([color[0].saturating_add((x % 16) as u8), color[1].saturating_add((y % 16) as u8), color[2], color[3]])
+    });
+    let mut bytes = Cursor::new(Vec::new());
+    image::DynamicImage::ImageRgba8(image).write_to(&mut bytes, image::ImageFormat::Png).unwrap();
+    bytes.into_inner()
+}
+fn fixture(artistic: bool) -> (Session, ShapeId, ShapeId, Vec<u8>) {
+    let mut s = Session::new();
+    s.execute("file.new", &json!({})).unwrap();
+    let original = png([20, 80, 150, 220], 32, 24);
+    let id = ShapeId(
