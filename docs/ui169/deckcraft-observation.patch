+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            let save = ui.add(egui::Button::new(egui::RichText::new(crate::host_ui::text("Save")).color(t.accent_text)).fill(t.accent).min_size(vec2(72.0, 24.0)));
+            if save.clicked() || ui.input(|i| i.key_pressed(egui::Key::Enter)) {
+                app.save();
+                // In the browser a save is a download: the presentation stays "unsaved".
+                let web = app.services.pick_save.is_none() && app.services.download.is_some();
+                if web || app.session.active().is_some_and(|d| !d.is_dirty()) {
+                    run(app, "file.close", json!({}));
+                }
+                done = true;
+            }
+            if ui.add(egui::Button::new(crate::host_ui::text("Cancel")).min_size(vec2(72.0, 24.0))).clicked() {
+                done = true;
+            }
+        });
+    });
+    done
+}
