+#[test]
+fn internal_clipboard_keeps_and_remaps_both_svg_and_preview_across_native_documents() {
+    let (mut s, id) = paired();
+    let source_id = fill(shape(&s, id)).svg_source.unwrap();
+    s.execute("edit.select", &json!({"ids":[id.0]})).unwrap();
+    s.execute("edit.copy", &json!({})).unwrap();
+    s.execute("file.new", &json!({})).unwrap();
+    // Identical PNG bytes deduplicate, so they cannot force a media-id
+    // collision. Distinct contributor-original prefix pixels occupy the old
+    // source's actual id; the copied SVG and its real preview stay untouched.
+    s.edit(|doc, _| {
+        for n in 0..16u8 {
+            if doc.media(source_id).is_some() {
+                break;
+            }
+            let mut bytes = Vec::new();
+            image::RgbaImage::from_pixel(1, 1, image::Rgba([n, 5, 6, 255])).write_to(&mut Cursor::new(&mut bytes), image::ImageFormat::Png).unwrap();
+            doc.add_media(&format!("prefix-{n}.png"), "image/png", bytes).unwrap();
+        }
+        assert_ne!(doc.media(source_id).unwrap().data.as_slice(), SVG);
+        Ok(())
+    })
+    .unwrap();
+    let pasted = s.execute("edit.paste", &json!({})).unwrap()["ids"][0].as_u64().unwrap();
+    let pasted = ShapeId(pasted as u32);
+    assert_ne!(fill(shape(&s, pasted)).svg_source.unwrap(), source_id);
+    assert_pair(&s.doc().unwrap().doc, shape(&s, pasted));
+    let loaded = deckcraft_format::load(&deckcraft_format::save(&s.doc().unwrap().doc).unwrap()).unwrap();
+    let copied = loaded.slides.iter().find_map(|sl| deckcraft_model::find_shape(&sl.shapes, pasted)).unwrap();
+    assert_pair(&loaded, copied);
