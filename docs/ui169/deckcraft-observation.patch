+#[test]
+fn content_replacement_preserves_exact_layout_group_crop_style_and_other_use() {
+    let (mut s, id, other, original) = fixture(false);
+    let before = (*s.doc().unwrap().doc).clone();
+    let history = s.doc().unwrap().history.undo.len();
+    let replacement = png([150, 20, 30, 200], 48, 16);
+    let value =
+        s.execute("picture.replaceContent", &json!({"ids":[id],"name":"actual-new.png","data":crate::cmd::base64_encode(&replacement)})).unwrap();
+    assert_eq!(value["ids"], json!([id]));
+    let after = &s.doc().unwrap().doc;
+    assert_eq!(normalized(after, &before, id), serde_json::to_value(&before).unwrap());
+    assert_eq!(serde_json::to_value(find(after, other)).unwrap(), serde_json::to_value(find(&before, other)).unwrap());
+    let ShapeKind::Picture { fill } = &find(after, id).kind else { panic!("picture") };
+    assert_eq!(after.media(fill.media).unwrap().data.as_slice(), replacement.as_slice());
+    assert!(after.media.iter().any(|m| m.data.as_slice() == original.as_slice()));
+    assert_eq!(s.doc().unwrap().history.undo.len(), history + 1);
+    let native = deckcraft_format::save(after).unwrap();
+    let reopened = deckcraft_format::load(&native).unwrap();
+    assert_eq!(serde_json::to_value(&reopened).unwrap(), serde_json::to_value(after).unwrap());
+    let pptx = deckcraft_pptx::export(after).unwrap();
+    assert!(deckcraft_pptx::import_checked(&pptx).is_ok());
+    s.execute("edit.undo", &json!({})).unwrap();
+    assert_eq!(serde_json::to_value(&s.doc().unwrap().doc).unwrap(), serde_json::to_value(&before).unwrap());
