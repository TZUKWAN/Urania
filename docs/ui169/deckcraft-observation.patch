+#![allow(clippy::unwrap_used, clippy::panic, clippy::expect_used)]
+//! Native conversion of actual contributor-original Vector exports and previews.
+use deckcraft_engine::Session;
+use deckcraft_model::{Geom, Presentation, Shape, ShapeId, ShapeKind};
+use serde_json::{Value, json};
+use std::io::{Cursor, Read};
+const SIMPLE: &[u8] = include_bytes!("fixtures/dsh-svg-conversion/source.svg");
+const SIMPLE_PREVIEW: &[u8] = include_bytes!("fixtures/dsh-svg-conversion/preview.png");
+const TEXT: &[u8] = include_bytes!("fixtures/dsh-svg-conversion/text.svg");
+const TEXT_PREVIEW: &[u8] = include_bytes!("fixtures/dsh-svg-conversion/text-preview.png");
+const COMPLEX: &[u8] = include_bytes!("fixtures/host-svg/source.svg");
+const COMPLEX_PREVIEW: &[u8] = include_bytes!("fixtures/host-svg/preview.png");
+fn session() -> Session {
+    let mut s = Session::new();
+    s.execute("file.new", &json!({})).unwrap();
+    s
+}
+fn insert(s: &mut Session, svg: &[u8], preview: &[u8], rect: [f64; 4]) -> ShapeId {
+    let result=s.execute("insert.svgPicture",&json!({"name":"actual.svg","data":deckcraft_engine::cmd::base64_encode(svg),"previewData":deckcraft_engine::cmd::base64_encode(preview),"rect":rect})).unwrap();
+    ShapeId(result["id"].as_u64().unwrap() as u32)
+}
+fn find(p: &Presentation, id: ShapeId) -> &Shape {
+    p.slides.iter().find_map(|slide| deckcraft_model::find_shape(&slide.shapes, id)).unwrap()
+}
+fn original_svg(p: &Presentation, id: ShapeId) -> &[u8] {
+    let ShapeKind::Picture { fill } = &find(p, id).kind else { panic!("expected original picture") };
+    p.media(fill.svg_source.unwrap()).unwrap().data.as_slice()
+}
+fn entry(bytes: &[u8], name: &str) -> String {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let mut file = zip.by_name(name).unwrap();
+    let mut text = String::new();
+    file.read_to_string(&mut text).unwrap();
+    text
