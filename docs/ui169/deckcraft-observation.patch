+                        return Err("outlined SVG text is unsupported".into());
+                    }
+                    no_remaining(&a)?;
+                    Frame { tag, style: st, text: Some(TextBuilder { x, y, tx, ty, name, value: String::new(), span: false }) }
+                } else {
+                    let geometry = shape(&tag, &mut a, view.ok_or("missing SVG viewBox")?)?;
+                    no_remaining(&a)?;
+                    items.push(Item { name, geometry, style: st.clone() });
+                    if items.len() > MAX_ITEMS {
+                        return Err("SVG object count exceeds budget".into());
+                    }
+                    Frame { tag, style: st, text: None }
+                };
+                if opens {
+                    stack.push(frame);
+                } else if frame.text.is_some() {
+                    return Err("empty SVG text is unsupported".into());
+                }
+            }
+            Event::End(_) => {
+                let frame = stack.pop().ok_or("unmatched SVG end")?;
+                if let Some(TextBuilder { x, y, tx, ty, name, value, .. }) = frame.text {
+                    if value.is_empty() || value.trim() != value || value.chars().any(char::is_control) || value.contains("  ") {
+                        return Err("SVG text whitespace or empty text is unsupported".into());
+                    }
+                    if !inside(view.ok_or("missing SVG viewBox")?, x + tx, y + ty) {
