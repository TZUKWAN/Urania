+fn find(p: &deckcraft_model::Presentation, id: ShapeId) -> &deckcraft_model::Shape {
+    p.slides.iter().find_map(|slide| deckcraft_model::find_shape(&slide.shapes, id)).unwrap()
+}
+fn normalized(after: &deckcraft_model::Presentation, before: &deckcraft_model::Presentation, id: ShapeId) -> Value {
+    let mut result = after.clone();
+    result.media = before.media.clone();
+    result.next_id = before.next_id;
+    let old = find(before, id);
+    let new = deckcraft_model::find_shape_mut(&mut Arc::make_mut(&mut result.slides[0]).shapes, id).unwrap();
+    let (ShapeKind::Picture { fill: old }, ShapeKind::Picture { fill: new }) = (&old.kind, &mut new.kind) else { panic!("pictures") };
+    new.media = old.media;
+    if let (Some(old), Some(new)) = (&old.artistic, &mut new.artistic) {
+        new.original = old.original;
+    }
+    serde_json::to_value(&result).unwrap()
+}
