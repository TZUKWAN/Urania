+                },
+            );
+            ui.add_space(14.0);
+            heading(ui, "Settings");
+            let scope = match bs.print_scope {
+                PrintScope::All => "Print All Slides",
+                PrintScope::Current => "Print Current Slide",
+                PrintScope::Custom => "Custom Range",
+            };
