+fn line_preset_label(kind: &str, value: &str) -> &'static str {
+    if kind == "exactly" {
+        "Exactly"
+    } else {
+        match value {
+            "1" => "Single",
+            "1.5" => "1.5 lines",
+            "2" => "Double",
+            _ => "Multiple",
+        }
+    }
+}
