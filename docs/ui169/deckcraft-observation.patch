+                for (s, label) in
+                    [(PrintScope::All, "Print All Slides"), (PrintScope::Current, "Print Current Slide"), (PrintScope::Custom, "Custom Range")]
+                {
+                    if ui.selectable_label(bs.print_scope == s, label).clicked() {
