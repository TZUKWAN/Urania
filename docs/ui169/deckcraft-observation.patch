+        r["probe"] = crate::cmd::media::probe_json(i);
+    }
+    Ok(r)
+}
+
+pub(super) fn audio(s: &mut Session, p: &Value) -> Result<Value> {
+    media(s, p, false)
+}
+
+pub(super) fn video(s: &mut Session, p: &Value) -> Result<Value> {
+    media(s, p, true)
+}
