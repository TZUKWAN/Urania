+pub(super) fn picture_adjust(s: &mut Session, p: &Value) -> Result<Value> {
+    edit_shapes(s, p, "picture.adjust", |sh| {
+        if let deckcraft_model::ShapeKind::Picture { fill } = &mut sh.kind {
