+        .unwrap();
+    let id = ShapeId(id as u32);
+    // Construct a model input for codecs. Native SVG insert/replace is a
+    // subsequent integration unit; do not pretend it exists in this test.
+    s.edit(|doc, _| {
+        let source = doc.add_media("original-vector.svg", "image/svg+xml", SVG.to_vec()).unwrap();
+        let target = deckcraft_model::find_shape_mut(&mut std::sync::Arc::make_mut(&mut doc.slides[0]).shapes, id).unwrap();
