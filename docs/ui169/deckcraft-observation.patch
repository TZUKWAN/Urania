+    s.execute("picture.adjust", &json!({"ids":[id],"brightness":0.2,"contrast":0.1,"saturation":0.8,"transparency":0.25})).unwrap();
+    s.execute("shape.effects", &json!({"ids":[id],"shadow":"outer","softEdges":2})).unwrap();
+    if artistic {
