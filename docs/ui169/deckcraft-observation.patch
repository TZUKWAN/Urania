+        let after = s.execute("shape.inspect", &json!({"id": id})).unwrap();
+        let mut expected = before["shape"]["text"].clone();
+        expected["paragraphs"][0]["runs"][0]["text"] = json!("After");
+        assert_eq!(after["shape"]["text"], expected, "plain text replacement must retain existing paragraph default and end formatting");
