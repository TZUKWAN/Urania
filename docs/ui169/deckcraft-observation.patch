+pub struct VoiceSpec {
+    pub clip: ClipParams,
+    pub looping: bool,
+    /// Media duration in seconds from the probe (0 = unknown: taken from the decoded audio).
+    pub duration: f64,
+    /// Decode and mix the audio (false for videos without sound, or muted).
+    pub audio: bool,
