+/// The name the gallery shows for preset `name` (the preset itself when it has none).
+pub fn pattern_label(name: &str) -> &str {
+    PATTERN_LABELS.iter().find(|(n, _)| *n == name).map_or(name, |(_, l)| l)
+}
