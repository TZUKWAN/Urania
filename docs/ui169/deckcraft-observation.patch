+/// A content-only native edit: never reset crop/effects or recreate the layout object.
+pub(super) fn picture_replace_content(s: &mut Session, p: &Value) -> Result<Value> {
+    const CMD: &str = "picture.replaceContent";
+    let material = crate::cmd::host_material::request(p, CMD)?;
+    let ids = crate::cmd::targets(s, p)?;
+    if ids.is_empty() || ids.len() > 100 {
+        return Err(bad(CMD, "pass one to 100 actual pictures"));
+    }
+    let (name, bytes) = crate::cmd::insert::media_bytes(p, CMD)?;
+    crate::embedded::picture_admission(&bytes, 24_000_000).map_err(|error| bad(CMD, error))?;
+    let mut work = Vec::new();
+    let mut processed = std::collections::BTreeMap::new();
+    {
+        let st = s.doc()?;
+        for id in &ids {
+            let shape = st.shape(*id).ok_or_else(|| bad(CMD, "target picture no longer exists"))?;
+            let origin = material.as_ref().map(|m| crate::cmd::host_material::prepare(Some(shape), m, true, CMD)).transpose()?;
+            if shape.locked {
+                return Err(bad(CMD, "target picture is locked"));
+            }
+            let deckcraft_model::ShapeKind::Picture { fill } = &shape.kind else {
+                return Err(bad(CMD, "every target must be an actual picture"));
+            };
+            if fill.svg_source.is_some() {
+                return Err(bad(CMD, "an SVG picture needs picture.replaceSvgContent; its original SVG was not discarded"));
+            }
+            let effect = fill.artistic.as_ref().map(|art| art.effect.clone());
+            if let Some(effect) = &effect
+                && !processed.contains_key(effect) {
+                processed.insert(effect.clone(), crate::cmd::artistic::process(effect, &bytes)?);
+            }
+            work.push((*id, effect, origin));
+        }
+    }
+    let ct = crate::cmd::insert::content_type(&name, &bytes);
+    s.edit(move |doc, selection| {
+        let original = doc.add_media(&name, ct, bytes).ok_or_else(|| bad(CMD, NO_ID_SPACE))?;
+        let mut rendered = std::collections::BTreeMap::new();
+        for (effect, data) in processed {
+            let id = doc.add_media(&format!("{}-{}.png", name, effect), "image/png", data).ok_or_else(|| bad(CMD, NO_ID_SPACE))?;
+            rendered.insert(effect, id);
+        }
+        let shapes = crate::shapes_mut(doc, selection).ok_or_else(|| bad(CMD, "no native target tree"))?;
+        for (id, effect, origin) in &work {
+            let shape = deckcraft_model::find_shape_mut(shapes, *id).ok_or_else(|| bad(CMD, "picture disappeared during replacement"))?;
+            let deckcraft_model::ShapeKind::Picture { fill } = &mut shape.kind else {
+                return Err(bad(CMD, "target changed kind"));
+            };
+            fill.media = effect.as_ref().and_then(|effect| rendered.get(effect)).copied().unwrap_or(original);
+            if let Some(art) = fill.artistic.as_mut() {
+                art.original = original;
+            }
+            if let Some(value) = origin { crate::cmd::host_material::set(shape, value.clone()); }
+        }
+        Ok(json!({"ids":work.iter().map(|(id,_,_)|id.0).collect::<Vec<_>>(),"media":original.0}))
+    })
+}
