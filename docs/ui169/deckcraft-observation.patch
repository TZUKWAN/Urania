+        || fill.upright
+    {
+        return Err(bad(CONVERT, "cropped, recoloured, transparent or effected pictures are unsupported; original SVG retained"));
+    }
+    let source = fill.svg_source.and_then(|id| state.doc.media(id)).ok_or_else(|| bad(CONVERT, "picture has no preserved original SVG"))?;
+    if source.content_type != "image/svg+xml" || source.link.is_some() {
+        return Err(bad(CONVERT, "original SVG is unavailable or external"));
+    }
+    let plan = parse(source.data.as_slice()).map_err(|reason| bad(CONVERT, format!("{reason}; original SVG retained")))?;
+    let sx = frame.w / plan.view[2];
+    let sy = frame.h / plan.view[3];
+    if !sx.is_finite() || !sy.is_finite() || sx <= 0.0 || sy <= 0.0 || (sx - sy).abs() > 1e-9 * (1.0 + sx.abs().max(sy.abs())) {
+        return Err(bad(CONVERT, "nonuniformly scaled SVG pictures are unsupported; original SVG retained"));
+    }
+    if plan.items.iter().any(|item| item.style.stroke.is_some()) {
+        return Err(bad(CONVERT, "SVG strokes are not yet supported; original SVG retained"));
+    }
+    for item in &plan.items {
+        if let Geometry::Path(d) = &item.geometry {
+            if item.style.fill.is_none() {
+                return Err(bad(CONVERT, "invisible SVG paths are unsupported; original SVG retained"));
+            }
+            let path = BezPath::from_svg(d).map_err(|_| bad(CONVERT, "SVG path data became invalid"))?;
+            let starts = path.elements().iter().filter(|e| matches!(e, PathEl::MoveTo(_))).count();
+            let closes = path.elements().iter().filter(|e| matches!(e, PathEl::ClosePath)).count();
+            if starts != 1 || closes != 1 || !matches!(path.elements().last(), Some(PathEl::ClosePath)) {
+                return Err(bad(CONVERT, "open or compound SVG paths are unsupported; original SVG retained"));
+            }
+        }
+    }
+    Ok((*id, frame, plan))
+}
+
+fn coordinate(v: f64) -> String {
+    let s = format!("{v:.7}");
+    let s = s.trim_end_matches('0').trim_end_matches('.');
+    if s == "-0" || s.is_empty() { "0".into() } else { s.into() }
+}
+fn native_path(d: &str, view: [f64; 4]) -> std::result::Result<String, String> {
+    let mut path = BezPath::from_svg(d).map_err(|_| "SVG path data became invalid")?;
+    path.apply_affine(Affine::translate((-view[0], -view[1])));
+    let mut out = String::new();
+    for e in path.elements() {
+        let part = match *e {
+            PathEl::MoveTo(p) => format!("M {} {}", coordinate(p.x), coordinate(p.y)),
+            PathEl::LineTo(p) => format!("L {} {}", coordinate(p.x), coordinate(p.y)),
+            PathEl::QuadTo(a, b) => format!("Q {} {} {} {}", coordinate(a.x), coordinate(a.y), coordinate(b.x), coordinate(b.y)),
+            PathEl::CurveTo(a, b, c) => {
+                format!("C {} {} {} {} {} {}", coordinate(a.x), coordinate(a.y), coordinate(b.x), coordinate(b.y), coordinate(c.x), coordinate(c.y))
+            }
+            PathEl::ClosePath => "Z".into(),
+        };
+        if !out.is_empty() {
+            out.push(' ');
+        }
+        out.push_str(&part);
+        if out.len() > 2 * 1024 * 1024 {
+            return Err("native path exceeds budget".into());
+        }
+    }
+    if out.is_empty() {
+        return Err("native path is empty".into());
+    }
+    Ok(out)
+}
+fn shape_name(item: &Item, index: usize) -> String {
+    if item.name.is_empty() { format!("SVG object {}", index + 1) } else { item.name.clone() }
+}
+fn converted_shapes(plan: &Plan, frame: Xfrm) -> std::result::Result<Vec<Shape>, String> {
+    let scale = frame.w / plan.view[2];
+    let mut shapes = Vec::with_capacity(plan.items.len());
+    for (index, item) in plan.items.iter().enumerate() {
+        let name = shape_name(item, index);
+        let shape = match &item.geometry {
+            Geometry::Path(d) => {
+                let path = native_path(d, plan.view)?;
+                Shape {
+                    name,
+                    xfrm: Some(frame),
+                    geom: Geom::Custom {
+                        paths: vec![CustomPath {
+                            w: plan.view[2],
+                            h: plan.view[3],
+                            d: path,
+                            fill: if item.style.fill.is_some() {
+                                deckcraft_geom::preset::FillMode::Norm
+                            } else {
+                                deckcraft_geom::preset::FillMode::None
+                            },
+                            stroke: false,
+                        }],
+                    },
+                    fill: Some(item.style.fill.map_or(Fill::None, |c| Fill::solid(ColorRef::rgb(c)))),
+                    line: Some(Line::none()),
+                    ..Default::default()
+                }
+            }
+            Geometry::Text { x, y, value } => {
+                let color = item.style.fill.ok_or("invisible SVG text is unsupported")?;
+                let font_size = item.style.font_size * scale;
+                let left = frame.x + (x - plan.view[0]) * scale;
+                let baseline = frame.y + (y - plan.view[1]) * scale;
+                let top = baseline - font_size * 0.8;
+                let width = frame.x + frame.w - left;
+                let height = font_size * 1.5;
+                if !font_size.is_finite()
+                    || font_size <= 0.0
+                    || font_size > 4096.0
+                    || !left.is_finite()
+                    || !top.is_finite()
+                    || top < frame.y
+                    || width <= 0.0
+                    || height <= 0.0
+                {
+                    return Err("SVG text frame cannot be safely represented".into());
+                }
+                let mut text = TextBody::from_text(value);
+                text.body.inset_l = Some(0.0);
+                text.body.inset_r = Some(0.0);
+                text.body.inset_t = Some(0.0);
+                text.body.inset_b = Some(0.0);
+                text.body.wrap = Some(false);
+                text.body.autofit = Some(AutoFit::None);
+                let run = text.paragraphs.first_mut().and_then(|p| p.runs.first_mut()).ok_or("SVG text has no editable run")?;
+                run.props.size = Some(font_size);
+                run.props.fill = Some(Fill::solid(ColorRef::rgb(color)));
+                run.props.font = item
+                    .style
+                    .font
+                    .as_ref()
+                    .and_then(|f| f.split(',').next())
+                    .map(|f| f.trim().trim_matches(['\'', '"']).to_string())
+                    .filter(|f| !f.is_empty());
+                Shape {
+                    name,
+                    xfrm: Some(Xfrm::new(left, top, width, height)),
+                    geom: Geom::preset("rect"),
+                    fill: Some(Fill::None),
+                    line: Some(Line::none()),
+                    text_box: true,
+                    text: Some(text),
+                    ..Default::default()
+                }
+            }
+        };
+        shapes.push(shape);
+    }
+    Ok(shapes)
+}
+
+pub(super) fn convert(s: &mut Session, p: &Value) -> Result<Value> {
+    let (id, frame, plan) = prepare(s, p)?;
+    let text_count = plan.items.iter().filter(|item| matches!(item.geometry, Geometry::Text { .. })).count();
+    let mut made = converted_shapes(&plan, frame).map_err(|reason| bad(CONVERT, format!("{reason}; original SVG retained")))?;
+    s.edit(move |doc,selection|{
+        for shape in &mut made {shape.id=ShapeId(doc.alloc_id().ok_or_else(||bad(CONVERT,super::NO_ID_SPACE))?);}
+        let ids=made.iter().map(|shape|shape.id).collect::<Vec<_>>();
+        let native_shapes=serde_json::to_value(&made).map_err(|_|bad(CONVERT,"cannot record converted native objects"))?;
+        if native_shapes.to_string().len()>1024*1024{return Err(bad(CONVERT,"converted native objects exceed the safe receipt budget; original SVG retained"));}
+        let list=crate::shapes_mut(doc,selection).ok_or_else(||bad(CONVERT,"no slide available"))?;
+        let index=list.iter().position(|shape|shape.id==id).ok_or_else(||bad(CONVERT,"original SVG picture changed"))?;
+        let original=list.get_mut(index).ok_or_else(||bad(CONVERT,"original SVG picture disappeared"))?;original.hidden=true;
+        list.splice(index+1..index+1,made);
+        selection.shapes=ids.clone();selection.text=None;
+        Ok(json!({"originalId":id.0,"originalRetained":true,"originalHidden":true,"ids":ids.iter().map(|id|id.0).collect::<Vec<_>>(),"nativeShapes":native_shapes,"textCount":text_count,"warnings":if text_count>0{vec!["Text font metrics and baseline may differ; the original SVG is retained as a hidden picture"]}else{vec![]}}))
+    })
+}
