-fn walk_clip(shapes: &[deckcraft_model::Shape], id: ShapeId) -> Option<MediaClip> {
-    shapes.iter().find_map(|s| match &s.kind {
-        ShapeKind::Media(m) if s.id == id => Some(m.clone()),
-        ShapeKind::Group { children, .. } => walk_clip(children, id),
-        _ => None,
-    })
-}
