+        host.gifs(2, &b, 0, 50.0, &none);
+        assert_eq!(host.gifs.get(&id).map(|c| c.0), Some(50.0), "a new document starts its own clock");
+        host.set_document(None);
+        assert!(host.gifs.is_empty());
+    }
