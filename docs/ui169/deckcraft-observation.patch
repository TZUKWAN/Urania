+    if ui.button(crate::host_ui::text("Format Background…")).clicked() {
+        let _ = app.run("view.pane", json!({"pane": "background"}));
+        ui.close();
+    }
+    if ui.button(crate::host_ui::text("New Comment")).clicked() {
+        app.dialog = Some(crate::dialogs::Dialog::new("comment"));
+        ui.close();
+    }
