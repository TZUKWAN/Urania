-fn select(s: &mut Session, p: &Value) -> Result<Value> {
-    let ids = match ids_param(p, "ids") {
-        Some(v) => v,
-        None => id_param(p, "id", "edit.select")?.map(|i| vec![i]).unwrap_or_default(),
-    };
-    let add = bool_or(p, "add", false);
-    let toggle = bool_or(p, "toggle", false);
